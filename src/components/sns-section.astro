---
import GitHubIcon from '@/assets/logo/github.svg'
import XIcon from '@/assets/logo/x.svg'
import SpeakerDeckIcon from '@/assets/logo/speakerdeck.svg'

const links = [
  { href: 'https://github.com/tocomi', label: 'GitHub', icon: GitHubIcon },
  { href: 'https://x.com/tocomi0112', label: 'X (Twitter)', icon: XIcon },
  {
    href: 'https://speakerdeck.com/tocomi',
    label: 'SpeakerDeck',
    icon: SpeakerDeckIcon,
  },
]
---

<section>
  <div class="-ml-2.5 flex flex-wrap">
    {
      links.map(({ href, label, icon }) => (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex size-11 items-center justify-center rounded-full transition-colors hover:bg-ground"
          aria-label={label}
        >
          <img src={icon.src} alt="" class="size-6" />
        </a>
      ))
    }
  </div>
</section>
