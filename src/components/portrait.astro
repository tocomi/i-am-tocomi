---
import { Image } from 'astro:assets'
import portrait from '@/assets/portrait.jpg'

type Props = {
  size: number
}

const { size } = Astro.props
// NOTE: 画像サイズに合わせてボーダー幅を調整
const borderWidth = Math.max(1, Math.round(size * 0.025))
---

<button
  type="button"
  class="portrait-wrapper spinning"
  style={`--size: ${size}px; --border-width: ${borderWidth}px`}
  transition:name="portrait"
  aria-label="ポートレートの回転を止める"
  aria-pressed="false"
>
  <Image
    src={portrait}
    alt=""
    width={size}
    height={size}
    class="rounded-full"
    fetchpriority="high"
    loading="eager"
  />
</button>

<style>
  .portrait-wrapper {
    width: var(--size);
    height: var(--size);
    padding: var(--border-width);
    border-radius: 9999px;
    background: linear-gradient(90deg, purple, orange);
    display: inline-block;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .portrait-wrapper:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .portrait-wrapper.spinning {
    animation: spin 3s linear infinite;
  }

  .portrait-wrapper.spinning.paused {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait-wrapper.spinning {
      animation: none;
    }
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .portrait-wrapper :global(img) {
    display: block;
    object-fit: cover;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const portraits = document.querySelectorAll('.portrait-wrapper')

    portraits.forEach(portrait => {
      portrait.addEventListener('click', () => {
        const paused = portrait.classList.toggle('paused')
        portrait.setAttribute('aria-pressed', String(paused))
      })
    })
  })
</script>
