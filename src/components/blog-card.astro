---
import ExternalArrow from '@/components/external-arrow.astro'
import type { Blog } from '@/content/types'
import { formatMonthDay } from '@/utils/date-util'

type Props = Blog & {
  href: string
  excerpt?: string
}

const { href, title, pubDate, tags, external, excerpt } = Astro.props

const externalHost = external ? new URL(external.url).host : undefined
---

<article class="border-t border-line-soft">
  <a
    href={external ? href : `${href}/`}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    class="group grid gap-x-4 gap-y-1 py-5.5 sm:grid-cols-[64px_minmax(0,1fr)]"
  >
    <time
      datetime={pubDate.toISOString()}
      class="text-sm/[26px] text-muted tabular-nums"
    >
      {formatMonthDay(pubDate)}
    </time>
    <div class="min-w-0">
      <h3
        class="text-[17px] leading-[1.55] font-[650] tracking-[-0.005em] text-ink transition-colors group-hover:text-accent-text"
        style="font-feature-settings: 'palt'"
      >
        {title}
      </h3>
      {
        excerpt && (
          <p class="mt-1.5 line-clamp-2 text-sm leading-[1.75] tracking-[0.02em] text-muted">
            {excerpt}
          </p>
        )
      }
      <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
        {tags.map(tag => <span class="tag">{tag}</span>)}
        {
          externalHost && (
            <span class="ml-1 inline-flex items-center gap-1 text-xs text-muted">
              {externalHost}
              <ExternalArrow />
            </span>
          )
        }
      </div>
    </div>
  </a>
</article>
