---
import Portrait from '@/components/portrait.astro'

const currentPath = Astro.url.pathname
const isHome = currentPath === '/'

const links = [
  { href: '/', label: 'Home', current: isHome },
  {
    href: '/about/',
    label: 'About',
    current: currentPath.startsWith('/about'),
  },
  { href: '/blog/', label: 'Blog', current: currentPath.startsWith('/blog') },
]
---

<header class="sticky top-0 z-50 border-b border-line bg-surface">
  <div
    class="mx-auto flex max-w-[808px] items-center justify-between gap-3 px-4 py-2 sm:px-6"
  >
    {/* NOTE: Home 以外では本文の大きいポートレートがヘッダーのポートレートに縮んで移る */}
    {
      isHome ? (
        <span class="inline-flex min-h-11 items-center text-[17px] font-bold tracking-[-0.01em] text-ink">
          tocomi
        </span>
      ) : (
        <Portrait size={40} />
      )
    }
    <nav aria-label="メイン" class="-mr-2.5 flex items-center gap-1">
      {
        links.map(({ href, label, current }) => (
          <a
            href={href}
            aria-current={current ? 'page' : undefined}
            class:list={[
              'inline-flex min-h-11 items-center px-2.5 text-sm font-medium transition-colors hover:text-ink',
              current
                ? 'text-ink shadow-[inset_0_-2px_0_var(--color-accent)]'
                : 'text-muted',
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
