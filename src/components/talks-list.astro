---
import { talks } from '@/content/talks'
import { formatFullDate } from '@/utils/date-util'
---

{
  talks.length > 0 && (
    <section>
      <h2 class="section-title">登壇</h2>
      <ul>
        {talks.map(talk => (
          <li class="grid gap-x-4 gap-y-1 border-t border-line-soft py-4.5 first:border-t-0 first:pt-0 sm:grid-cols-[96px_minmax(0,1fr)]">
            <time
              datetime={talk.date.toISOString()}
              class="text-sm/[26px] text-muted tabular-nums"
            >
              {formatFullDate(talk.date)}
            </time>
            <div class="min-w-0">
              <a
                href={talk.eventUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="leading-[1.6] font-[650] text-ink transition-colors hover:text-accent-text"
                style="font-feature-settings: 'palt'"
              >
                {talk.eventName}
              </a>
              <p class="mt-0.5 text-sm leading-[1.75] tracking-[0.02em] text-muted">
                {talk.slideUrl ? (
                  <a
                    href={talk.slideUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-link"
                  >
                    {talk.title}
                  </a>
                ) : (
                  talk.title
                )}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}
