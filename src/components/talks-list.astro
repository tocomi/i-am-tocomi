---
import { talks } from '@/content/talks'
import { formatFullDate } from '@/utils/date-util'

const linkClass =
  'text-link inline-flex min-h-11 items-center gap-0.5 text-sm font-medium sm:min-h-7'
---

{
  talks.length > 0 && (
    <section>
      <h2 class="section-title">登壇</h2>
      <ul>
        {talks.map(talk => (
          <li class="grid gap-x-4 gap-y-1 border-t border-line-soft py-4.5 first:border-t-0 first:pt-0 sm:grid-cols-[96px_minmax(0,1fr)]">
            <time
              datetime={talk.date.toISOString()}
              class="text-sm/[26px] text-muted tabular-nums"
            >
              {formatFullDate(talk.date)}
            </time>
            <div class="min-w-0">
              <h3
                class="leading-[1.6] font-[650] text-ink"
                style="font-feature-settings: 'palt'"
              >
                {talk.eventName}
              </h3>
              {/* NOTE: タイトルと同じ行に収まらないときは、リンクだけ次の行の右端に折り返す */}
              <div class="mt-0.5 flex flex-wrap items-center gap-x-4 gap-y-2">
                <p class="text-sm leading-[1.75] tracking-[0.02em] text-muted">
                  {talk.title}
                </p>
                <div class="-my-2.5 ml-auto flex gap-x-5 sm:my-0 sm:gap-x-4">
                  <a
                    href={talk.eventUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${talk.eventName} のイベントページ`}
                    class={linkClass}
                  >
                    イベント<span aria-hidden="true">↗</span>
                  </a>
                  {talk.slideUrl && (
                    <a
                      href={talk.slideUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${talk.title} の資料`}
                      class={linkClass}
                    >
                      資料<span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}
