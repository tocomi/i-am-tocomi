---
import Layout from '@/layouts/layout.astro'
import Portrait from '@/components/portrait.astro'
import TalksList from '@/components/talks-list.astro'
import SnsSection from '@/components/sns-section.astro'
---

<Layout title="Home" ogpPath="home">
  <section class="card flex flex-wrap items-center gap-x-9 gap-y-7">
    <Portrait size={136} />
    <div class="min-w-0 flex-[1_1_320px]">
      <h1
        class="text-2xl leading-[1.3] font-bold tracking-[-0.015em] text-ink sm:text-[28px]"
      >
        Kenta TSUNEMI
      </h1>
      <p class="mt-0.5 mb-3.5 text-[15px] font-medium text-muted">@tocomi</p>
      <p class="text-[15px] leading-[1.8] tracking-[0.02em]">
        Web Frontend Engineer at Techtouch, Inc.<br />
        TSKaigi スタッフ(2025, 2026, Sendai)
      </p>
      <p
        class="mt-2 mb-2 text-[15px] leading-[1.8] font-medium tracking-[0.02em] text-ink"
      >
        笑いの取れるエンジニアを目指しています🗿
      </p>
      <SnsSection />
    </div>
  </section>

  <TalksList />
</Layout>
