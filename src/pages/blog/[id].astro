---
import { getCollection, render } from 'astro:content'

import BackToBlogs from '@/components/back-to-blogs.astro'
import Layout from '@/layouts/layout.astro'
import { formatFullDate } from '@/utils/date-util'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const formattedDate = formatFullDate(post.data.pubDate)
---

<Layout title={post.data.title} ogpPath={`blog/${post.id}`}>
  <div class="-mt-2 mb-2 [animation:fadeUp_0.3s_ease_both]">
    <BackToBlogs />
  </div>

  <header
    class="mb-7 [animation:fadeUp_0.35s_ease_both] [animation-delay:0.05s]"
  >
    <h1 class="page-title mb-3.5">{post.data.title}</h1>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <time
        datetime={post.data.pubDate.toISOString()}
        class="text-sm text-muted tabular-nums"
      >
        {formattedDate}
      </time>
      <div class="flex flex-wrap gap-1.5">
        {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </header>

  <article
    class="card custom-md [animation:fadeUp_0.4s_ease_both] [animation-delay:0.1s]"
  >
    <Content />
  </article>

  <div class="mt-6">
    <BackToBlogs />
  </div>
</Layout>

<style is:global>
  /* ── Prose ── */
  .custom-md {
    font-size: 0.9375rem;
    line-height: 1.9;
    letter-spacing: 0.04em;

    @media (width >= 40rem) {
      padding: 2.5rem;
      font-size: 1rem;
    }
  }

  .custom-md > :first-child {
    margin-top: 0;
  }

  .custom-md > :last-child {
    margin-bottom: 0;
  }

  .custom-md h2 {
    margin: 2.5rem 0 1.125rem;

    @media (width >= 40rem) {
      margin-top: 3rem;
    }
  }

  .custom-md h3 {
    margin: 2.25rem 0 0.625rem;
    color: var(--color-ink);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: -0.005em;
    font-feature-settings: 'palt';
  }

  .custom-md h2 + h3 {
    margin-top: 1.25rem;
  }

  .custom-md p {
    margin-bottom: 1em;
  }

  .custom-md a {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--color-accent-line);
    text-underline-offset: 0.22em;
    transition: text-decoration-color 0.12s ease;
  }

  .custom-md a:hover {
    text-decoration-color: var(--color-accent);
  }

  .custom-md ul,
  .custom-md ol {
    margin-bottom: 1em;
    padding-left: 1.5em;
  }

  .custom-md ul {
    list-style: disc;
  }

  .custom-md ol {
    list-style: decimal;
  }

  .custom-md li {
    margin-bottom: 0.25em;
  }

  .custom-md li::marker {
    color: var(--color-muted);
  }

  .custom-md li > ul,
  .custom-md li > ol {
    margin: 0.25em 0 0;
  }

  .custom-md blockquote {
    margin: 1.5em 0;
    padding-left: 1em;
    border-left: 3px solid var(--color-line);
    color: var(--color-muted);
  }

  .custom-md blockquote p:last-child {
    margin-bottom: 0;
  }

  .custom-md pre {
    margin: 1.5em 0;
    padding: 1rem;
    overflow-x: auto;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.7;
    letter-spacing: 0;
  }

  .custom-md :not(pre) > code {
    padding: 0.15em 0.4em;
    border-radius: 0.25rem;
    background: var(--color-ground);
    font-size: 0.9em;
    letter-spacing: 0;
  }

  .custom-md img {
    display: block;
    max-width: 100%;
    margin: 1.5em auto;
    border-radius: 0.5rem;
  }

  .custom-md strong {
    color: var(--color-ink);
    font-weight: 700;
  }

  .custom-md hr {
    margin: 2.5rem 0;
    border: none;
    border-top: 1px solid var(--color-line);
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
